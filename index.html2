<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Swift Ride</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" rel="stylesheet">
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0A0A0B;--bg2:#171614;--bg3:#201E1A;--bg4:#26231D;
  --gold:#C8A45A;--gold2:#F2D89A;--gold3:#8A6A2A;--gold-hi:#FFE9B8;--gold-dp:#6E5220;
  --txt:#F5EFDF;--txt2:#A39A88;--txt3:#655D4F;
  --green:#2ECC71;--red:#E74C3C;--r:16px;--r2:12px;
  --ease:cubic-bezier(.16,1,.3,1  );
  --shadow-card:0 10px 30px -12px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.03);
  --shadow-gold:0 8px 26px -8px rgba(200,164,90,.35);
}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--txt);font-family:'Tajawal',sans-serif;direction:rtl;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-font-smoothing:antialiased}
body{
  background:
    radial-gradient(120% 60% at 50% -10%, rgba(200,164,90,.10), transparent 60%),
    radial-gradient(90% 50% at 90% 110%, rgba(200,164,90,.06), transparent 60%),
    radial-gradient(60% 40% at 0% 100%, rgba(120,90,30,.08), transparent 60%),
    var(--bg);
}
.app{
  width:100%;max-width:430px;margin:0 auto;
  height:100dvh;height:100vh;
  display:flex;flex-direction:column;position:relative;overflow:hidden;
  background:linear-gradient(180deg,#0C0C0D 0%,#0A0A0B 40%,#0A0A0B 100%);
  box-shadow:0 0 60px rgba(0,0,0,.6);
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
.app::before{
  content:'';position:absolute;inset:0;pointer-events:none;z-index:0;opacity:.5;
  background-image:radial-gradient(rgba(255,255,255,.028) 1px, transparent 1px);
  background-size:3px 3px;
  mix-blend-mode:overlay;
}
.screen{
  position:absolute;inset:0;display:flex;flex-direction:column;
  opacity:0;pointer-events:none;
  transform:translateY(22px) scale(.985);
  filter:blur(6px);
  transition:opacity .5s var(--ease),transform .5s var(--ease),filter .5s var(--ease);
  z-index:1;
}
.screen.active{opacity:1;pointer-events:all;transform:translateY(0) scale(1);filter:blur(0)}
.screen.out{opacity:0;transform:translateY(-14px) scale(.98);filter:blur(4px);pointer-events:none}
 
@keyframes riseIn{
  from{opacity:0;transform:translateY(14px) scale(.97)}
  to{opacity:1;transform:translateY(0) scale(1)}
}
.screen.active .topbar{animation:riseIn .5s var(--ease) both}
.screen.active .prog-wrap{animation:riseIn .5s var(--ease) .04s both}
.screen.active .card,
.screen.active .offer,
.screen.active .trip-banner,
.screen.active .drv,
.screen.active .active-chip{animation:riseIn .55s var(--ease) both;animation-delay:.06s}
.screen.active .stats .stat,
.screen.active .qgrid>*,
.screen.active .car-types .ct,
.screen.active .act-grid .act-btn{animation:riseIn .5s var(--ease) both}
.screen.active .stats .stat:nth-child(1),.screen.active .qgrid>*:nth-child(1),.screen.active .car-types .ct:nth-child(1),.screen.active .act-grid .act-btn:nth-child(1){animation-delay:.08s}
.screen.active .stats .stat:nth-child(2),.screen.active .qgrid>*:nth-child(2),.screen.active .car-types .ct:nth-child(2),.screen.active .act-grid .act-btn:nth-child(2){animation-delay:.14s}
.screen.active .stats .stat:nth-child(3),.screen.active .qgrid>*:nth-child(3),.screen.active .car-types .ct:nth-child(3),.screen.active .act-grid .act-btn:nth-child(3){animation-delay:.2s}
.screen.active .qgrid>*:nth-child(4),.screen.active .act-grid .act-btn:nth-child(4){animation-delay:.26s}
.screen.active .choice-btn{animation:riseIn .45s var(--ease) both}
.screen.active .choice-btn:nth-of-type(1){animation-delay:.08s}
.screen.active .choice-btn:nth-of-type(2){animation-delay:.14s}
.screen.active .choice-btn:nth-of-type(3){animation-delay:.2s}
.screen.active #s-offers .offer:nth-of-type(1){animation-delay:.06s}
.screen.active #s-offers .offer:nth-of-type(2){animation-delay:.16s}
.screen.active #s-offers .offer:nth-of-type(3){animation-delay:.26s}
.screen.active .bottom{animation:riseIn .5s var(--ease) .18s both}
 
.scroll{flex:1;overflow-y:auto;overflow-x:hidden;padding:0 16px 32px;-webkit-overflow-scrolling:touch;position:relative;z-index:1}
::-webkit-scrollbar{width:2px}::-webkit-scrollbar-thumb{background:var(--gold3);border-radius:2px}
.topbar{padding:calc(16px + env(safe-area-inset-top,0px)) 18px 12px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;position:relative;z-index:1}
.logo{font-size:11px;letter-spacing:4px;font-weight:700;background:linear-gradient(90deg,var(--gold-hi),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent;opacity:.95;text-transform:uppercase}
.back-btn{background:var(--bg3);border:1px solid rgba(200,164,90,.18);color:var(--gold);font-size:19px;cursor:pointer;padding:6px 12px;line-height:1;border-radius:10px;transition:all .2s var(--ease)}
.back-btn:active{transform:scale(.9);border-color:var(--gold)}
.menu-btn{width:36px;height:36px;border-radius:10px;background:var(--bg3);border:1px solid rgba(200,164,90,.15);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;cursor:pointer;transition:all .2s}
.menu-btn:active{transform:scale(.92);border-color:rgba(200,164,90,.4)}
.menu-dot{height:1.5px;background:var(--txt2);border-radius:2px}
.prog-wrap{height:4px;background:rgba(200,164,90,.08);border-radius:3px;margin-bottom:16px;overflow:hidden;position:relative}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--gold3),var(--gold2),var(--gold-hi));border-radius:3px;transition:width .5s var(--ease);position:relative;overflow:hidden;box-shadow:0 0 10px rgba(232,200,122,.5)}
.prog-fill::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);width:40%;animation:shimmerSweep 1.8s ease-in-out infinite}
@keyframes shimmerSweep{0%{transform:translateX(-120%)}100%{transform:translateX(340%)}}
.card{background:linear-gradient(180deg,var(--bg3),var(--bg2));border:1px solid rgba(200,164,90,.14);border-radius:var(--r);padding:16px;margin-bottom:10px;box-shadow:var(--shadow-card)}
.card-gold{background:linear-gradient(150deg,#1B1408,#16110A 55%,#120E08);border-color:rgba(200,164,90,.32);box-shadow:var(--shadow-card),0 0 0 1px rgba(200,164,90,.05) inset}
.stats{display:flex;gap:8px;margin-bottom:14px}
.stat{flex:1;background:linear-gradient(180deg,var(--bg3),var(--bg2));border:1px solid rgba(200,164,90,.12);border-radius:var(--r2);padding:13px 8px;text-align:center;box-shadow:var(--shadow-card)}
.stat-val{font-size:21px;font-weight:800;background:linear-gradient(180deg,var(--gold-hi),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent}
.stat-lbl{font-size:10px;color:var(--txt2);margin-top:3px;font-weight:500}
.qgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.qbtn{background:linear-gradient(165deg,var(--bg3),var(--bg2));border:1px solid rgba(200,164,90,.14);border-radius:var(--r);padding:16px 14px;cursor:pointer;transition:all .25s var(--ease);position:relative;overflow:hidden;box-shadow:var(--shadow-card)}
.qbtn::before{content:'';position:absolute;top:0;right:0;width:70px;height:70px;background:radial-gradient(circle at top right,rgba(232,200,122,.12),transparent 70%)}
.qbtn:active{transform:scale(.96);border-color:var(--gold)}
.qbtn.full{grid-column:span 2;display:flex;align-items:center;gap:14px;padding:20px 18px;background:linear-gradient(135deg,#1E1608,#191204 60%,#140F06);border-color:rgba(200,164,90,.45);box-shadow:var(--shadow-card),var(--shadow-gold)}
.q-icon{font-size:26px;display:block;margin-bottom:8px;filter:drop-shadow(0 2px 6px rgba(0,0,0,.4))}
.q-lbl{font-size:13px;font-weight:700;color:var(--txt)}
.q-sub{font-size:11px;color:var(--txt2);margin-top:3px}
.vip-badge{background:linear-gradient(135deg,var(--gold-hi),var(--gold));color:#1A1204;font-size:9px;font-weight:800;padding:3px 10px;border-radius:20px;letter-spacing:.5px;display:inline-block;margin-bottom:7px;box-shadow:0 2px 8px rgba(200,164,90,.4)}
.active-chip{margin:0 0 12px;background:linear-gradient(135deg,#0F1A0A,#141F0E);border:1px solid rgba(46,204,113,.28);border-radius:var(--r);padding:14px 16px;display:flex;align-items:center;gap:12px;cursor:pointer;box-shadow:var(--shadow-card);transition:transform .2s var(--ease)}
.active-chip:active{transform:scale(.98)}
.profile-hero{display:flex;flex-direction:column;align-items:center;padding:14px 0 22px;text-align:center}
.avatar-wrap{position:relative;width:104px;height:104px;margin-bottom:14px;cursor:pointer}
.avatar-ring{width:100%;height:100%;border-radius:50%;background:linear-gradient(150deg,var(--gold-hi),var(--gold),var(--gold3));padding:3.5px;box-shadow:0 12px 30px -8px rgba(200,164,90,.5)}
.avatar-ring #avatar-fallback{width:100%;height:100%;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(160deg,var(--bg4),var(--bg3));font-size:42px}
.avatar-ring #avatar-img{width:100%;height:100%;border-radius:50%;object-fit:cover;background:var(--bg3);display:none}
.avatar-wrap.has-photo .avatar-ring #avatar-img{display:block}
.avatar-wrap.has-photo .avatar-ring #avatar-fallback{display:none}
.avatar-edit{position:absolute;bottom:-2px;left:-2px;width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--gold-hi),var(--gold));display:flex;align-items:center;justify-content:center;font-size:14px;border:3px solid var(--bg);box-shadow:0 4px 10px rgba(0,0,0,.45);transition:transform .2s var(--ease)}
.avatar-wrap:active .avatar-edit{transform:scale(.85)}
.profile-name{font-size:19px;font-weight:800;color:var(--txt)}
.profile-sub{font-size:11.5px;color:var(--gold2);margin-top:5px;letter-spacing:.3px}
.slabel{font-size:10.5px;font-weight:700;color:var(--gold2);letter-spacing:1.2px;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.inp-wrap{background:var(--bg3);border:1px solid rgba(200,164,90,.16);border-radius:var(--r2);display:flex;align-items:center;gap:10px;padding:14px;margin-bottom:10px;transition:all .25s var(--ease)}
.inp-wrap:focus-within{border-color:rgba(232,200,122,.65);box-shadow:0 0 0 3px rgba(200,164,90,.1)}
.inp-wrap input, .inp-wrap select{flex:1;background:none;border:none;outline:none;font-family:'Tajawal',sans-serif;font-size:14px;color:var(--txt);caret-color:var(--gold);width:100%}
.inp-wrap input::placeholder{color:var(--txt3)}
.inp-wrap select option {background:var(--bg);color:var(--txt);}
.inp-icon{font-size:16px;flex-shrink:0}
.dot-chain{display:flex;flex-direction:column;align-items:center;gap:3px;padding:14px 0;flex-shrink:0}
.dot-o{width:10px;height:10px;border-radius:50%;border:2px solid var(--gold3)}
.dot-line{width:1.5px;height:26px;background:linear-gradient(180deg,var(--gold3),var(--gold))}
.dot-f{width:10px;height:10px;border-radius:50%;background:var(--gold);box-shadow:0 0 8px rgba(200,164,90,.6)}
.car-types{display:flex;gap:8px;margin-bottom:14px}
.ct{flex:1;background:var(--bg3);border:2px solid rgba(200,164,90,.1);border-radius:var(--r2);padding:13px 6px;text-align:center;cursor:pointer;transition:all .25s var(--ease)}
.ct.sel,.ct:active{border-color:var(--gold);background:rgba(200,164,90,.09);box-shadow:var(--shadow-gold)}
.ct-icon{font-size:22px;display:block;margin-bottom:4px}
.ct-name{font-size:11px;font-weight:700;color:var(--txt)}
.ct-price{font-size:10px;color:var(--gold2);margin-top:2px}
.choice-btn{background:var(--bg3);border:1px solid rgba(200,164,90,.15);border-radius:12px;padding:16px 18px;font-size:14px;font-weight:700;color:var(--txt);cursor:pointer;transition:all .22s var(--ease);text-align:center;font-family:'Tajawal',sans-serif}
.choice-btn:active,.choice-btn.sel{border-color:var(--gold);background:linear-gradient(135deg,rgba(200,164,90,.14),rgba(200,164,90,.05));color:var(--gold2);box-shadow:var(--shadow-gold)}
.time-chip{background:var(--bg3);border:1px solid rgba(200,164,90,.15);border-radius:20px;padding:8px 15px;font-size:12px;font-weight:700;color:var(--txt2);cursor:pointer;transition:all .2s var(--ease);font-family:'Tajawal',sans-serif}
.time-chip:active{border-color:var(--gold);color:var(--gold2);background:rgba(200,164,90,.08);transform:scale(.95)}
.gps-btn{width:100%;background:rgba(200,164,90,.07);border:2px dashed rgba(200,164,90,.4);border-radius:12px;padding:14px;color:var(--gold2);font-family:'Tajawal',sans-serif;font-size:13px;font-weight:700;cursor:pointer;margin-bottom:10px;transition:all .25s var(--ease)}
.gps-btn:active{transform:scale(.98)}
.gps-btn.done{border-color:var(--green);border-style:solid;color:var(--green);background:rgba(46,204,113,.08);box-shadow:0 0 16px rgba(46,204,113,.15)}
.irow{display:flex;align-items:center;gap:10px;background:var(--bg4);border-radius:11px;padding:11px 13px;margin-bottom:8px;font-size:13px;border:1px solid rgba(200,164,90,.06)}
.irow .lbl{color:var(--txt2);flex:1}
.irow .val{color:var(--txt);font-weight:700;text-align:left;font-size:12px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pill{display:inline-flex;align-items:center;gap:6px;padding:5px 13px;border-radius:20px;font-size:11px;font-weight:700}
.pill.s{background:rgba(200,164,90,.1);color:var(--gold2);border:1px solid rgba(200,164,90,.28)}
.pill.a{background:rgba(46,204,113,.1);color:var(--green);border:1px solid rgba(46,204,113,.28)}
.blink{width:6px;height:6px;border-radius:50%;background:currentColor;animation:blink 1s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
.bottom{padding:12px 16px;padding-bottom:calc(12px + env(safe-area-inset-bottom,0px));flex-shrink:0;border-top:1px solid rgba(200,164,90,.08);position:relative;z-index:1;background:linear-gradient(0deg,rgba(10,10,11,.9),transparent)}
.btn-p{width:100%;background:linear-gradient(135deg,var(--gold-hi),var(--gold2),var(--gold));border:none;border-radius:var(--r);padding:16px;color:#1A1204;font-family:'Tajawal',sans-serif;font-size:15px;font-weight:800;cursor:pointer;transition:all .22s var(--ease);box-shadow:0 6px 24px -4px rgba(200,164,90,.45);position:relative;overflow:hidden}
.btn-p::after{content:'';position:absolute;inset:0;background:linear-gradient(115deg,transparent 30%,rgba(255,255,255,.5) 48%,transparent 65%);transform:translateX(-120%);transition:none}
.btn-p:not(:disabled):active{transform:scale(.97)}
.btn-p:not(:disabled)::after{animation:shineSweep 3.2s ease-in-out infinite}
@keyframes shineSweep{0%,60%{transform:translateX(-120%)}85%{transform:translateX(120%)}100%{transform:translateX(120%)}}
.btn-p:disabled{opacity:.4;cursor:not-allowed;box-shadow:none}
.btn-p:disabled::after{display:none}
.btn-s{width:100%;background:rgba(200,164,90,.04);border:1px solid rgba(200,164,90,.3);border-radius:var(--r);padding:14px;color:var(--gold2);font-family:'Tajawal',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:all .2s var(--ease)}
.btn-s:active{background:rgba(200,164,90,.1);transform:scale(.98)}
.btn-d{width:100%;background:rgba(231,76,60,.05);border:1px solid rgba(231,76,60,.32);border-radius:var(--r);padding:13px;color:var(--red);font-family:'Tajawal',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s var(--ease)}
.btn-d:active{background:rgba(231,76,60,.1);transform:scale(.98)}
/* pax counter */
.pax-wrap{display:flex;align-items:center;justify-content:center;gap:26px;margin:10px 0 14px}
.pax-btn{width:50px;height:50px;border-radius:50%;background:var(--bg3);border:1px solid rgba(200,164,90,.22);color:var(--gold2);font-size:26px;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1;font-family:'Tajawal',sans-serif;transition:all .18s var(--ease);box-shadow:var(--shadow-card)}
.pax-btn:active{transform:scale(.88);border-color:var(--gold)}
.pax-val{font-size:46px;font-weight:800;background:linear-gradient(180deg,var(--gold-hi),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent;min-width:56px;text-align:center}
/* radar */
.radar-box{display:flex;flex-direction:column;align-items:center;padding:24px 20px 18px}
/* offers */
.offer{background:linear-gradient(180deg,var(--bg3),var(--bg2));border:1px solid rgba(200,164,90,.16);border-radius:var(--r);padding:16px;margin-bottom:10px;position:relative;overflow:hidden;box-shadow:var(--shadow-card);transition:transform .2s var(--ease)}
.offer:active{transform:scale(.985)}
.offer::before{content:'';position:absolute;top:0;right:0;left:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold3),transparent)}
.offer.best{background:linear-gradient(150deg,#1C1509,#191307 60%,#140F07);border-color:rgba(200,164,90,.5);box-shadow:var(--shadow-card),0 0 0 1px rgba(200,164,90,.08) inset,var(--shadow-gold)}
.best-tag{position:absolute;top:-1px;left:20px;background:linear-gradient(135deg,var(--gold-hi),var(--gold));color:#1A1204;font-size:9px;font-weight:800;padding:4px 12px;border-radius:0 0 9px 9px;box-shadow:0 4px 10px rgba(200,164,90,.35)}
.d-av{width:46px;height:46px;border-radius:50%;background:linear-gradient(150deg,var(--gold-hi),var(--gold3));display:flex;align-items:center;justify-content:center;font-size:19px;border:2px solid rgba(200,164,90,.35);flex-shrink:0;box-shadow:0 4px 12px rgba(0,0,0,.4)}
.btn-acc{width:100%;background:linear-gradient(135deg,var(--gold-hi),var(--gold));border:none;border-radius:11px;padding:13px;color:#1A1204;font-family:'Tajawal',sans-serif;font-size:14px;font-weight:800;cursor:pointer;transition:all .2s var(--ease);box-shadow:0 4px 16px -4px rgba(200,164,90,.5)}
.btn-acc:active{transform:scale(.97)}
/* active trip */
.trip-banner{margin:10px 16px 10px;background:linear-gradient(180deg,var(--bg3),var(--bg2));border:1px solid rgba(200,164,90,.22);border-radius:var(--r);padding:22px;text-align:center;box-shadow:var(--shadow-card)}
.trip-icon{font-size:50px;display:block;margin-bottom:10px;animation:flt 2.5s ease-in-out infinite;filter:drop-shadow(0 6px 14px rgba(200,164,90,.35))}
@keyframes flt{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
